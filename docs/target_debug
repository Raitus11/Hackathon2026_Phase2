$j = Invoke-RestMethod "http://localhost:8080/audit?limit=200&operation=MQSC_ALTER_QMGR"
   $j.entries | Where-Object { $_.request_payload.mqsc_text -like "*CHLAUTH*" } | Measure-Object


$j = Invoke-RestMethod "http://localhost:8080/audit?limit=50&operation=MQSC_DEFINE_CHANNEL_SDR"
$j.entries | Where-Object { $_.success -eq $false } | Select-Object qm_name, error_message -First 3 | Format-List
