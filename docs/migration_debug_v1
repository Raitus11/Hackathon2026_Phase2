$m = Invoke-RestMethod "http://localhost:8080/migrations/1"
$m.steps | Select-Object step_index, audit_op, succeeded, error_message | Format-Table -Wrap


$a = Invoke-RestMethod "http://localhost:8080/migrations/1/audit?limit=300"
$a.entries | Where-Object { $_.success -eq $false } | Select-Object lamport_clock, operation, error_message | Format-List
